#!/usr/bin/env bash
# Vibecrafted commit-msg hook.
#
# Enforces the agent/runtime commit standard:
#
#   [codex/interactive] chore: Polish Makefile help output formatting
#
#   Refactors the help target to use structured printf output.
#
#   Authored-By: codex <agents@vetcoders.io>
#   session_id: 019e93be-379d-7303-9ad4-ffae468db99f
#   timestamp: 2026_0604_1408_MDT
#   runtime: iterm2
#
# Humans keep a human address. `[maciej/manual]` may use
# `Authored-By: maciej <void@div0.space>`. Agents stay on
# `agents@vetcoders.io`. The example body below is not a required
# sentence — do not paste it into a real commit.

set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    printf 'commit-msg: expected path to commit message file\n' >&2
    exit 2
fi

first_line="$(head -n1 "$msg_file" | tr -d '\r')"

# Git-generated commit subjects have fixed forms; do not fight them here.
case "$first_line" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release|merge'
subject_max="${VIBECRAFTED_COMMIT_MSG_SUBJECT_MAX:-100}"
subject_pattern="^\\[([a-z][a-z0-9_-]*)/[a-z0-9][a-z0-9._-]*\\] (${types})(\\(.+\\))?: .{1,${subject_max}}$"

failures=()
agent=""
if [[ "$first_line" =~ $subject_pattern ]]; then
    agent="${BASH_REMATCH[1]}"
else
    failures+=("subject must be: [<agent>/<runtime>] <type>(<scope>): <subject>")
fi

if grep -Eiq '(^Co-Authored-By:|noreply@|@anthropic\.com|@openai\.com)' "$msg_file"; then
    failures+=("vendor footers are forbidden; use Authored-By only")
fi

# Humans are not agents. The founder/operator envelope is a real address,
# not agents@vetcoders.io. Runtime `manual` or a known human subject name
# selects that lane. Everyone else stays fail-closed on the agent mailbox.
human_agents='maciej|monika'
human_emails='void@div0\.space|hello@vetcoders\.io'
runtime_lane=""
if [[ "$first_line" =~ ^\[([^]/]+)/([^]]+)\] ]]; then
    runtime_lane="${BASH_REMATCH[2]}"
fi
is_human=0
if [ -n "$agent" ] && [[ "$agent" =~ ^(${human_agents})$ ]]; then
    is_human=1
fi
if [ "$runtime_lane" = "manual" ]; then
    is_human=1
fi

if [ "$is_human" -eq 1 ]; then
    author="${agent:-maciej}"
    if ! grep -Eq "^Authored-By: ${author} <(${human_emails})>$" "$msg_file"; then
        failures+=("missing Authored-By: ${author} <void@div0.space> (human lane; not agents@vetcoders.io)")
    fi
elif [ -n "$agent" ] && ! grep -Eq "^Authored-By: ${agent} <agents@vetcoders\\.io>$" "$msg_file"; then
    failures+=("missing Authored-By: ${agent} <agents@vetcoders.io>")
elif [ -z "$agent" ] && ! grep -Eq '^Authored-By: [a-z][a-z0-9_-]* <agents@vetcoders\.io>$' "$msg_file"; then
    failures+=("missing Authored-By: <agent> <agents@vetcoders.io>")
fi

if ! grep -Eq '^session_id: [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' "$msg_file"; then
    failures+=("missing session_id: <uuid>")
fi

if ! grep -Eq '^timestamp: [0-9]{4}_[0-9]{4}_[0-9]{4}_[A-Za-z0-9_+-]+$' "$msg_file"; then
    failures+=("missing timestamp: YYYY_MMDD_HHMM_TZ")
fi

if ! grep -Eq '^runtime: .+' "$msg_file"; then
    failures+=("missing runtime: <runtime name>")
fi

has_body=0
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
        "$first_line"|"") continue ;;
    esac
    if printf '%s\n' "$line" | grep -Eq '^(Authored-By|session_id|timestamp|runtime|Signed-off-by|Vibecrafted-Warn-Signature):'; then
        continue
    fi
    has_body=1
    break
done < "$msg_file"

if [ "$has_body" -ne 1 ]; then
    failures+=("commit message needs an explanatory body before trailers")
fi

if [ "${#failures[@]}" -eq 0 ]; then
    exit 0
fi

printf 'commit-msg: invalid Vibecrafted commit message\n' >&2
for failure in "${failures[@]}"; do
    printf '  - %s\n' "$failure" >&2
done
printf '\nAgent shape:\n' >&2
printf '  [codex/interactive] chore: describe the change\n\n' >&2
printf '  Why this commit exists.\n\n' >&2
printf '  Authored-By: codex <agents@vetcoders.io>\n' >&2
printf '  session_id: 019e93be-379d-7303-9ad4-ffae468db99f\n' >&2
printf '  timestamp: 2026_0604_1408_MDT\n' >&2
printf '  runtime: iterm2\n' >&2
printf '\nHuman shape:\n' >&2
printf '  [maciej/manual] feat: describe the change\n\n' >&2
printf '  Why this commit exists.\n\n' >&2
printf '  Authored-By: maciej <void@div0.space>\n' >&2
printf '  session_id: <uuid>\n' >&2
printf '  timestamp: YYYY_MMDD_HHMM_TZ\n' >&2
printf '  runtime: vibecrafted\n' >&2
exit 1
