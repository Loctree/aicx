#!/bin/sh
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"
HOOK_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

EMBARGO_ACTIVE=0
if "$HOOK_DIR/embargo.sh" status; then
  EMBARGO_ACTIVE=1
else
  status=$?
  [ "$status" -eq 1 ] || exit "$status"
fi

echo "=== Pre-commit (fast checks) ==="

STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -n "$STAGED_RS" ]; then
  echo "Running cargo fmt (auto-fix)..."
  cargo fmt --all

  echo "$STAGED_RS" | xargs -I {} git add "{}" 2>/dev/null || true

  if [ "$EMBARGO_ACTIVE" -eq 1 ]; then
    echo "Compile embargo active: cargo check deferred; fmt remains enforced."
  else
    echo "Running cargo check..."
    cargo check --quiet || {
      echo "Compilation errors. Fix before committing."
      exit 1
    }
  fi
fi

echo "Pre-commit checks passed."
