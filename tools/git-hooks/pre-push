#!/bin/sh
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"
HOOK_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

remote="$1"
url="$2"
ref_input=$(mktemp "${TMPDIR:-/tmp}/aicx-pre-push.XXXXXX")
trap 'rm -f "$ref_input"' EXIT HUP INT TERM
cat >"$ref_input"

EMBARGO_ACTIVE=0
if "$HOOK_DIR/embargo.sh" status; then
  EMBARGO_ACTIVE=1
else
  status=$?
  [ "$status" -eq 1 ] || exit "$status"
fi

echo "=== Pre-push validation ==="
echo "Pushing to: $remote ($url)"

if [ "$EMBARGO_ACTIVE" -eq 1 ]; then
  recovery_ref=$("$HOOK_DIR/embargo.sh" recovery-ref)
  ref_count=0
  while read -r _lref lsha rref _rsha; do
    [ -n "$rref" ] || continue
    ref_count=$((ref_count + 1))
    if [ "$rref" != "$recovery_ref" ]; then
      echo "Compile embargo blocks destination $rref; only $recovery_ref is permitted." >&2
      exit 1
    fi
    case "$lsha" in
      ''|*[!0]*) ;;
      *)
        echo "Compile embargo does not permit ref deletion." >&2
        exit 1
        ;;
    esac
  done <"$ref_input"
  if [ "$ref_count" -eq 0 ]; then
    echo "Compile embargo requires an explicit pre-push ref update." >&2
    exit 1
  fi
  RUST_TOUCHED=0
  echo "Compile embargo recovery ref verified -> light gate (manifest + fmt + semgrep)."
else
  # Baseline policy: decide whether this push touches Rust/Cargo files. If it
  # does not, skip the heavy clippy+test gates. Manifest, format, and semgrep
  # stay unconditional.
  RUST_TOUCHED=0
  HAVE_RANGE=0
  while read -r _lref lsha _rref rsha; do
    [ -z "$lsha" ] && continue
    case "$lsha" in *[!0]*) : ;; *) continue ;; esac
    HAVE_RANGE=1
    if printf '%s' "$rsha" | grep -qE '^0+$' || ! git cat-file -e "$rsha" 2>/dev/null; then
      base=$(git merge-base "$lsha" origin/develop 2>/dev/null || true)
      if [ -n "$base" ]; then
        files=$(git diff --name-only "$base" "$lsha")
      else
        files=$(git show --name-only --format= "$lsha")
      fi
    else
      files=$(git diff --name-only "$rsha" "$lsha")
    fi
    if printf '%s\n' "$files" | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)rust-toolchain'; then
      RUST_TOUCHED=1
    fi
  done <"$ref_input"
  [ "$HAVE_RANGE" = "0" ] && RUST_TOUCHED=1
  if [ "$RUST_TOUCHED" = "1" ]; then
    echo "Rust/Cargo changes detected -> full gate."
  else
    echo "No Rust/Cargo changes -> light gate (manifest + fmt + semgrep)."
  fi
fi

echo ""
echo "[1/5] Manifest portability..."
python3 - <<'PY'
try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

with open("Cargo.toml", "rb") as fh:
    data = tomllib.load(fh)

bad = [
    (section, name, spec["path"])
    for section in ("dependencies", "dev-dependencies", "build-dependencies")
    for name, spec in data.get(section, {}).items()
    if isinstance(spec, dict) and "path" in spec and "version" not in spec
]

if bad:
    raise SystemExit(
        "Manifest portability check failed:\n"
        + "\n".join(
            f"  - {section}.{name} is a local path dependency without a registry version: {path}"
            for section, name, path in bad
        )
    )

print("Manifest portability: ok (path dependencies carry registry versions)")
PY

echo ""
echo "[2/5] Format check (make fmt-check)..."
make fmt-check

if [ "$RUST_TOUCHED" = "1" ]; then
  echo ""
  echo "[3/5] Clippy (make clippy)..."
  make clippy

  echo ""
  echo "[4/5] Tests (make test)..."
  make test
else
  echo ""
  echo "[3/5] Clippy... skipped (no Rust/Cargo changes)"
  echo "[4/5] Tests... skipped (no Rust/Cargo changes)"
fi

echo ""
echo "[5/5] Semgrep (make semgrep)..."
make semgrep

echo ""
echo "=== All pre-push checks passed ==="
