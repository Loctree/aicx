#!/usr/bin/env bash
# Vibecrafted commit-msg hook.
#
# Enforces the agent/runtime commit standard.
#
# After the editor (and on `git commit -m`, where prepare-commit-msg already
# ran), this hook runs the sibling generator so an interactive commit still
# receives trailers. Validation then reads only the text above Git's scissors
# line — the part cleanup keeps. A trailer parked under the verbose diff
# must not satisfy the check and then disappear from the object.
#
#   [codex/interactive] chore: Polish Makefile help output formatting
#
#   Refactors the help target to use structured printf output.
#
#   Authored-By: codex <agents@vetcoders.io>
#   session_id: 019e93be-379d-7303-9ad4-ffae468db99f
#   time: 2026-06-04T14:08:27-06:00
#   runtime: iterm2
#   session_pid: 35432        (optional)
#
# Humans keep a human address. `[maciej/manual]` may use
# `Authored-By: maciej <void@div0.space>`. Agents stay on
# `agents@vetcoders.io`. The example body below is not a required
# sentence — do not paste it into a real commit.

set -euo pipefail

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    printf 'commit-msg: expected path to commit message file\n' >&2
    exit 2
fi

first_line="$(head -n1 "$msg_file" | tr -d '\r')"

# Git-generated commit subjects have fixed forms; do not fight them here.
case "$first_line" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|release|merge'
subject_max="${VIBECRAFTED_COMMIT_MSG_SUBJECT_MAX:-100}"
subject_pattern="^\\[([a-z][a-z0-9_-]*)/[a-z0-9][a-z0-9._-]*\\] (${types})(\\(.+\\))?: .{1,${subject_max}}$"

failures=()
agent=""
if [[ "$first_line" =~ $subject_pattern ]]; then
    agent="${BASH_REMATCH[1]}"
    prepare_hook="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/prepare-commit-msg"
    if [ -f "$prepare_hook" ]; then
        "$prepare_hook" "$msg_file" commit
    fi
else
    failures+=("subject must be: [<agent>/<runtime>] <type>(<scope>): <subject>")
fi

# Same comment prefix as prepare-commit-msg. A `;` scissors line is the cut
# when core.commentChar is `;`. core.commentChar=auto matches only a single
# character from the set Git can choose, never an arbitrary word: a prose
# line such as "NOTE ---- >8 ----" must not hide the footer under it.
comment_prefix="$(git config --get core.commentString 2>/dev/null || true)"
if [ -z "$comment_prefix" ]; then
    comment_prefix="$(git config --get core.commentChar 2>/dev/null || true)"
fi
comment_mode=fixed
case "$comment_prefix" in
    auto)
        comment_mode=auto
        comment_prefix='#'
        ;;
    "") comment_prefix='#' ;;
esac

# What Git will store: drop a real scissors marker and the verbose diff under
# it. Comment lines stay in the buffer; the checks below do not treat them as
# trailers or as an explanatory body.
kept_tmp="$(mktemp "${TMPDIR:-/tmp}/vc-kept.XXXXXX")"
trap 'rm -f "$kept_tmp"' EXIT
comment_prefix="$(awk \
    -v comment_prefix="$comment_prefix" \
    -v comment_mode="$comment_mode" \
    -v kept_path="$kept_tmp" \
    '
    function is_auto_char(c) { return index("#;@!$%^&|:", c) > 0 }
    function rest_is_cut(rest) {
        return rest ~ /^[[:space:]]+-{2,}[[:space:]]*>8[[:space:]]*-{2,}[[:space:]]*$/
    }
    function is_scissors(s,    c, rest) {
        if (match(s, /^[^[:space:]]+/)) {
            if (comment_mode == "auto" && RLENGTH != 1) return 0
        } else {
            return 0
        }
        if (comment_mode == "auto") {
            c = substr(s, 1, 1)
            if (!is_auto_char(c)) return 0
            return rest_is_cut(substr(s, 2))
        }
        if (comment_prefix == "" || index(s, comment_prefix) != 1) return 0
        rest = substr(s, length(comment_prefix) + 1)
        return rest_is_cut(rest)
    }
    {
        sub(/\r$/, "")
        if (!seen_cut && is_scissors($0)) {
            seen_cut = 1
            if (comment_mode == "auto") comment_prefix = substr($0, 1, 1)
            next
        }
        if (seen_cut) next
        print > kept_path
    }
    END {
        close(kept_path)
        print comment_prefix
    }
' "$msg_file")"
kept="$(cat "$kept_tmp")"
rm -f "$kept_tmp"
trap - EXIT

if printf '%s\n' "$kept" | grep -Eiq '(^Co-Authored-By:|noreply@|@anthropic\.com|@openai\.com)'; then
    failures+=("vendor footers are forbidden; use Authored-By only")
fi

# Humans are not agents. The founder/operator envelope is a real address,
# not agents@vetcoders.io. Runtime `manual` or a known human subject name
# selects that lane. Everyone else stays fail-closed on the agent mailbox.
human_agents='maciej|monika'
human_emails='void@div0\.space|hello@vetcoders\.io'
runtime_lane=""
if [[ "$first_line" =~ ^\[([^]/]+)/([^]]+)\] ]]; then
    runtime_lane="${BASH_REMATCH[2]}"
fi
is_human=0
if [ -n "$agent" ] && [[ "$agent" =~ ^(${human_agents})$ ]]; then
    is_human=1
fi
if [ "$runtime_lane" = "manual" ]; then
    is_human=1
fi

# Required provenance is the footer, not a citation in the body. The
# generator preserves a body line that looks like a trailer and does not
# treat it as measured.
footer="$(printf '%s\n' "$kept" | awk -v comment_prefix="$comment_prefix" '
    function is_comment(s) { return comment_prefix != "" && index(s, comment_prefix) == 1 }
    function is_trailer(s) { return s ~ /^[A-Za-z][A-Za-z0-9_-]*: / }
    { n++; lines[n] = $0 }
    END {
        end = n
        seen = 0
        while (end >= 1) {
            if (is_comment(lines[end])) { seen = 1; end--; continue }
            if (seen && lines[end] ~ /^[[:space:]]*$/) { end--; continue }
            break
        }
        while (end >= 1 && lines[end] ~ /^[[:space:]]*$/) end--
        bend = end
        bstart = end + 1
        while (end >= 1 && is_trailer(lines[end])) { bstart = end; end-- }
        if (bstart <= bend && end >= 1 && lines[end] !~ /^[[:space:]]*$/) exit
        for (i = bstart; i <= bend; i++) print lines[i]
    }
')"
if [ "$is_human" -eq 1 ]; then
    author="${agent:-maciej}"
    if ! printf '%s\n' "$footer" | grep -Eq "^Authored-By: ${author} <(${human_emails})>$"; then
        failures+=("missing Authored-By: ${author} <void@div0.space> (human lane; not agents@vetcoders.io)")
    fi
elif [ -n "$agent" ] && ! printf '%s\n' "$footer" | grep -Eq "^Authored-By: ${agent} <agents@vetcoders\\.io>$"; then
    failures+=("missing Authored-By: ${agent} <agents@vetcoders.io>")
elif [ -z "$agent" ] && ! printf '%s\n' "$footer" | grep -Eq '^Authored-By: [a-z][a-z0-9_-]* <agents@vetcoders\.io>$'; then
    failures+=("missing Authored-By: <agent> <agents@vetcoders.io>")
fi

# UUID everywhere. Junie also keeps the id AICX discovery returns:
# YYMMDD-HHMMSS-suffix, for example 260408-214715-abcd.
session_ok=0
if printf '%s\n' "$footer" | grep -Eq '^session_id: [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'; then
    session_ok=1
elif [ "$agent" = "junie" ] && printf '%s\n' "$footer" | grep -Eq '^session_id: [0-9]{6}(-[A-Za-z0-9]+)+$'; then
    session_ok=1
fi
if [ "$session_ok" -ne 1 ]; then
    if [ "$agent" = "junie" ]; then
        failures+=("missing session_id: <uuid or YYMMDD-HHMMSS-suffix>")
    else
        failures+=("missing session_id: <uuid>")
    fi
fi

if printf '%s\n' "$footer" | grep -Eq '^(timestamp|date): '; then
    failures+=("timestamp:/date: are legacy; the fleet standard is time: YYYY-MM-DDTHH:MM:SS+HH:MM")
fi
if ! printf '%s\n' "$footer" | grep -Eq '^time: [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$'; then
    failures+=("missing time: YYYY-MM-DDTHH:MM:SS+HH:MM")
fi

# session_pid is optional by design: it separates two live processes sharing one
# session_id, but requiring it would block manual commits and amends made
# outside an agent process. Validate the shape only when it is present.
if printf '%s\n' "$footer" | grep -Eq '^session_pid:' \
    && ! printf '%s\n' "$footer" | grep -Eq '^session_pid: [0-9]{1,10}$'; then
    failures+=("session_pid: must be a decimal process id when present")
fi

if ! printf '%s\n' "$footer" | grep -Eq '^runtime: .+'; then
    failures+=("missing runtime: <runtime name>")
fi

has_body=0
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
        "$first_line"|"") continue ;;
    esac
    if [ "${line#"$comment_prefix"}" != "$line" ]; then
        continue
    fi
    if printf '%s\n' "$line" | grep -Eq '^(Authored-By|session_id|session_pid|time|timestamp|date|runtime|Signed-off-by|Vibecrafted-Warn-Signature):'; then
        continue
    fi
    has_body=1
    break
done <<< "$kept"

if [ "$has_body" -ne 1 ]; then
    failures+=("commit message needs an explanatory body before trailers")
fi

if [ "${#failures[@]}" -eq 0 ]; then
    exit 0
fi

printf 'commit-msg: invalid Vibecrafted commit message\n' >&2
for failure in "${failures[@]}"; do
    printf '  - %s\n' "$failure" >&2
done
printf '\nAgent shape:\n' >&2
printf '  [codex/interactive] chore: describe the change\n\n' >&2
printf '  Why this commit exists.\n\n' >&2
printf '  Authored-By: codex <agents@vetcoders.io>\n' >&2
printf '  session_id: 019e93be-379d-7303-9ad4-ffae468db99f\n' >&2
printf '  time: 2026-06-04T14:08:27-06:00\n' >&2
printf '  runtime: iterm2\n' >&2
printf '\nHuman shape:\n' >&2
printf '  [maciej/manual] feat: describe the change\n\n' >&2
printf '  Why this commit exists.\n\n' >&2
printf '  Authored-By: maciej <void@div0.space>\n' >&2
printf '  session_id: <uuid>\n' >&2
printf '  time: YYYY-MM-DDTHH:MM:SS+HH:MM\n' >&2
printf '  runtime: vibecrafted\n' >&2
exit 1
